+/* Visual geometry of a rendered buffer that may contain newlines: total
+ * rows used, plus the cursor row (1-based) and column (0-based). A '\n'
+ * starts a new visual row at column zero; logical lines longer than the
+ * terminal width wrap like the terminal wraps them. In mask mode newlines
+ * are printed as mask characters, so they do not break rows. */
+static void renderGeometry(struct linenoiseState *l, const char *render,
+                           size_t len, size_t pos, size_t pwidth,
+                           int *rows, int *cursor_row, int *cursor_col) {
+    size_t cols = l->cols, ls = 0, startw = pwidth;
+    size_t i;
+    int row = 0, cursor_set = 0;
+
+    *cursor_row = 1;
+    *cursor_col = 0;
+    for (i = 0; ; i++) {
+        int at_nl = i < len && render[i] == '\n' && !maskmode;
+        if (i == len || at_nl) {
+            size_t lw = utf8StrWidth(render+ls, i-ls);
+            int line_rows = (int)((startw + lw) / cols) + 1;
+            if (startw + lw > 0 && (startw + lw) % cols == 0) line_rows--;
+            if (!cursor_set && pos <= i) {
+                size_t posw = utf8StrWidth(render+ls, pos-ls);
+                *cursor_row = row + (int)((startw + posw) / cols) + 1;
+                *cursor_col = (int)((startw + posw) % cols);
+                cursor_set = 1;
+            }
+            row += line_rows;
+            ls = i + 1;
+            startw = 0;
+            if (i == len) break;
+        }
+    }
+    *rows = row;
+}
