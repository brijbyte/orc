# Copy to deploy-opencode/.env and fill in. Environment variables override this file.

# Hetzner Cloud API token with Read & Write access.
HCLOUD_TOKEN=

# Reusable Tailscale auth key for first boot.
TS_AUTHKEY=

# Optional. Removes stale nodes during provision and destroy.
TS_API_KEY=

# Git identity. The private key defaults to deploy-opencode/git_ed25519.
# Credentials default to the ignored opencode-auth.json, agy-auth-token, and
# github-auth.yml files. Override them with OPENCODE_AUTH_FILE, AGY_AUTH_FILE,
# and GITHUB_AUTH_FILE.
GIT_BOT_NAME=opencode-bot
GIT_BOT_EMAIL=opencode-bot@users.noreply.github.com

# Configure at least one notification channel. Configured channels all receive each message.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_URL=
NTFY_TOKEN=
