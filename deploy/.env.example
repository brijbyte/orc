# Copy to deploy/.env (gitignored) and fill in. provision.sh/destroy.sh read
# these keys with sed (KEY=value, one per line, never sourced); the process
# environment wins, and ../orchestrator/.env is the fallback.

# Hetzner Cloud API token (Read & Write): console → project → Security → API tokens
HCLOUD_TOKEN=

# Tailscale auth key, for the VM to join the tailnet at first boot:
# https://login.tailscale.com/admin/settings/keys — reusable, or every
# rebuild needs a fresh one.
TS_AUTHKEY=

# Optional Tailscale API key. With it, provision removes a stale same-name
# node before boot and destroy removes the node from the tailnet.
TS_API_KEY=
